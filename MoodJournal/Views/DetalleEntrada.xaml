<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MoodJournal.Views.DetalleEntrada"
             BackgroundColor="#F7F1D1">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <Label Text="← volver al historial" FontSize="16" TextColor="#E57373">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>

            <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                <Border BackgroundColor="#E57373" StrokeShape="RoundRectangle 10" WidthRequest="60" HeightRequest="60">
                    <Label Text="{Binding Emoji}" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="{Binding FechaCompleta}" FontSize="14" TextColor="#666666" />
                    <HorizontalStackLayout Spacing="5">
                        <Label Text="Me sentía" FontSize="20" TextColor="#BC5D4E" />
                        <Label Text="{Binding Humor}" FontSize="20" FontAttributes="Bold" TextColor="#BC5D4E" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <Border BackgroundColor="White"
        Stroke="#E0E0E0"
        StrokeThickness="1"
        Padding="20"
        Margin="0,10,0,0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow Brush="Black"
                Offset="0,5"
                Radius="10"
                Opacity="0.1" />
                </Border.Shadow>
                <Label Text="{Binding Contenido}" 
                   FontSize="18" 
                   TextColor="#333333" 
                   LineBreakMode="WordWrap" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>