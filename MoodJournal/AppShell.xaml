<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MoodJournal.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MoodJournal.Views"
    Title="MoodJournal">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:Home}"
        Route="Home" />

    <ShellContent
    Title="Perfil"
    ContentTemplate="{DataTemplate local:Perfil}"
    Route="Perfil_tab" />

    <ShellContent
 Title="Historial"
 ContentTemplate="{DataTemplate local:Historial}"
 Route="Historial" />

    <ShellContent
 Title="Estadisticas"
 ContentTemplate="{DataTemplate local:Estadisticas}"
 Route="Estadisticas" />

    <ShellContent
Title="Calendario"
ContentTemplate="{DataTemplate local:Calendario}"
Route="Calendario" />

</Shell>